CREATE TABLE trusted (
  id TEXT NOT NULL PRIMARY KEY,
  admission TEXT NOT NULL
);
CREATE TABLE setting (key TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE local_group (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  group_id TEXT NOT NULL CHECK (length(group_id) > 0),
  founder_id TEXT NOT NULL CHECK (length(founder_id) > 0)
);
CREATE TABLE group_adoption_journal (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  attempt_id TEXT NOT NULL CHECK (length(attempt_id) = 64),
  local_identity TEXT NOT NULL CHECK (length(local_identity) = 64),
  peer_identity TEXT NOT NULL CHECK (length(peer_identity) = 64),
  group_id TEXT NOT NULL CHECK (length(group_id) = 64),
  founder_id TEXT NOT NULL CHECK (length(founder_id) = 64),
  payload BLOB NOT NULL CHECK (typeof(payload) = 'blob' AND length(payload) BETWEEN 1 AND 524288)
);
CREATE TABLE message (
  id TEXT NOT NULL PRIMARY KEY,
  sender TEXT NOT NULL,
  session TEXT NOT NULL,
  body TEXT NOT NULL,
  signature TEXT NOT NULL,
  received INTEGER NOT NULL DEFAULT 0
);
peers:
SELECT * FROM trusted;
trust:
INSERT OR REPLACE INTO trusted VALUES (?, ?);
untrust:
DELETE FROM trusted WHERE id = ?;
getSetting:
SELECT value FROM setting WHERE key = ?;
putSetting:
INSERT OR REPLACE INTO setting VALUES (?, ?);
localGroup:
SELECT group_id, founder_id FROM local_group WHERE singleton = 1;
foundLocalGroup:
INSERT INTO local_group(singleton, group_id, founder_id)
SELECT 1, ?, ? WHERE NOT EXISTS (SELECT 1 FROM local_group);
lastInsertCount:
SELECT changes();
pendingAdoptionJournalRecord:
SELECT singleton, attempt_id, local_identity, peer_identity, group_id, founder_id, typeof(payload) AS payload_type, payload
FROM group_adoption_journal;
stageGroupAdoption:
INSERT INTO group_adoption_journal(singleton, attempt_id, local_identity, peer_identity, group_id, founder_id, payload)
SELECT 1, ?, ?, ?, ?, ?, ?
WHERE NOT EXISTS (SELECT 1 FROM group_adoption_journal)
AND NOT EXISTS (SELECT 1 FROM local_group);
removeGroupAdoption:
DELETE FROM group_adoption_journal WHERE singleton = 1 AND attempt_id = ? AND local_identity = ?
AND peer_identity = ? AND group_id = ? AND founder_id = ? AND payload = ?;
getMessage:
SELECT * FROM message WHERE id = ?;
insertMessage:
INSERT INTO message(id, sender, session, body, signature) VALUES (?, ?, ?, ?, ?);
history:
SELECT * FROM message ORDER BY rowid DESC LIMIT 200;
ack:
UPDATE message SET received = 1 WHERE id = ?;
